---
const year = new Date().getFullYear();

const columns = [
  { title: "Company", links: ["About us", "Terms of use", "Contact us", "Careers"] },
  { title: "Get help", links: ["Payments option", "Delivery", "Contact us", "Returns"] },
  { title: "Product", links: ["Men", "Women", "Accessories", "Careers"] },
  { title: "Legal", links: ["Privacy policy", "Terms & conditions"] },
];

const socials = ["Facebook", "Instagram", "Twitter", "YouTube", "TikTok"];
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__tagline">We are committed about our quality</p>
        <div class="stripes site-footer__stripes" aria-hidden="true"></div>
        <svg class="site-footer__watermark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        {columns.map((col) => (
          <div class="site-footer__col">
            <h2 class="site-footer__heading">{col.title}</h2>
            <ul class="site-footer__list" role="list">
              {col.links.map((label) => (
                <li><a class="site-footer__link" href="#">{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="site-footer__bottom">
      <a class="site-footer__logo" href="/">
        <svg class="site-footer__logo-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="12" fill="currentColor"/>
          <path d="M12 5v14M5 12h14M7 7l10 10M17 7 7 17" stroke="#121212" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        <span>Classica</span>
      </a>

      <ul class="site-footer__socials" role="list" aria-label="Social media">
        {socials.map((name) => (
          <li><a class="site-footer__social" href="#">{name}</a></li>
        ))}
      </ul>

      <p class="site-footer__copy">&copy; {year} Classica. All rights reserved</p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  padding-block: clamp(2.5rem, 6vw, 4.5rem) 1.5rem;
  background: var(--color-ink); color: var(--color-white);
  font-family: var(--font-body);
}
.site-footer :focus-visible { outline-color: var(--color-white); }

/* ---- top: brand block + link columns ---- */
.site-footer__top {
  display: grid; gap: 2.5rem;
  padding-bottom: clamp(2rem, 5vw, 4rem);
}
.site-footer__brand {
  position: relative; display: grid; align-content: start; gap: 1.25rem;
}
.site-footer__tagline {
  max-width: 14ch; margin: 0;
  font: 600 .85rem/1.35 var(--font-body); letter-spacing: .02em; text-transform: uppercase;
}
.site-footer__stripes { --stripes-w: 8.5rem; --stripes-h: 3.75rem; }
.site-footer__watermark {
  position: absolute; top: 0; left: clamp(8rem, 14vw, 11rem);
  width: clamp(4rem, 7vw, 5.5rem); height: auto; color: rgb(255 255 255 / .12);
}

.site-footer__nav {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem;
}
.site-footer__heading {
  margin: 0 0 .75rem;
  font: 600 .8rem/1.2 var(--font-body); letter-spacing: .04em; text-transform: uppercase;
}
.site-footer__list { margin: 0; padding: 0; list-style: none; }
.site-footer__link {
  display: inline-block; padding-block: .3rem;
  color: rgb(255 255 255 / .6); text-decoration: none;
  font: 500 .72rem/1.2 var(--font-body); letter-spacing: .04em; text-transform: uppercase;
  transition: color .2s;
}
.site-footer__link:hover { color: var(--color-accent); }

/* ---- bottom: logo, social pills, copyright ---- */
.site-footer__bottom {
  display: grid; justify-items: start; gap: 1.5rem;
  padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / .12);
}
.site-footer__logo {
  display: inline-flex; align-items: center; gap: .5rem;
  color: var(--color-white); text-decoration: none;
  font: 400 1.35rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .02em;
}
.site-footer__logo-mark { width: 1.5rem; height: 1.5rem; color: var(--color-accent); }
.site-footer__socials {
  display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none;
}
.site-footer__social {
  display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: 1.1rem;
  border: 1px solid rgb(255 255 255 / .35); border-radius: var(--radius-pill);
  color: var(--color-white); text-decoration: none;
  font: 500 .68rem/1 var(--font-body); letter-spacing: .06em; text-transform: uppercase;
  transition: background-color .2s, color .2s, border-color .2s;
}
.site-footer__social:hover { background: var(--color-white); border-color: var(--color-white); color: var(--color-ink); }
.site-footer__copy {
  margin: 0; color: rgb(255 255 255 / .6);
  font: 500 .68rem/1.2 var(--font-body); letter-spacing: .04em; text-transform: uppercase;
}

@media (min-width: 48rem) {
  .site-footer__nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
@media (min-width: 60rem) {
  .site-footer__top { grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); }
  .site-footer__bottom { grid-template-columns: auto 1fr auto; align-items: center; justify-items: stretch; }
  .site-footer__socials { justify-content: center; }
}
</style>
