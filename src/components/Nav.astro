<header class="site-header">
  <div class="container">
    <nav class="site-nav" aria-label="Primary">
      <a class="site-nav__logo" href="/">
        <svg class="site-nav__logo-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="12" fill="currentColor"/>
          <path d="M12 5v14M5 12h14M7 7l10 10M17 7 7 17" stroke="#EF5A28" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        <span class="site-nav__logo-text">Classica</span>
      </a>
 
      <ul class="site-nav__list" role="list">
        <li class="site-nav__item"><a class="site-nav__link" href="#new-arrival">New arrival</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="#product">Product</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="#collection">Collection</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="#brand">Brand</a></li>
      </ul>
 
      <div class="site-nav__actions">
        <a class="site-nav__cart" href="/cart" aria-label="Cart, 0 items">Cart <span data-cart-count>(0)</span></a>
        <a class="site-nav__login" href="/login">Login</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
          <span class="menu-toggle__bar menu-toggle__bar--top" aria-hidden="true"></span>
          <span class="menu-toggle__bar menu-toggle__bar--bottom" aria-hidden="true"></span>
        </button>
      </div>
    </nav>
  </div>
 
  <div class="mobile-menu" id="mobile-menu" inert>
    <nav aria-label="Mobile">
      <ul class="mobile-menu__list" role="list">
        <li class="mobile-menu__item"><a class="mobile-menu__link" style="--i:0" href="#new-arrival">New arrival</a></li>
        <li class="mobile-menu__item"><a class="mobile-menu__link" style="--i:1" href="#product">Product</a></li>
        <li class="mobile-menu__item"><a class="mobile-menu__link" style="--i:2" href="#collection">Collection</a></li>
        <li class="mobile-menu__item"><a class="mobile-menu__link" style="--i:3" href="#brand">Brand</a></li>
      </ul>
    </nav>
    <div class="mobile-menu__footer">
      <a class="btn btn--primary" href="/login">
        Login
        <span class="btn__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
      <ul class="mobile-menu__socials" role="list">
        <li><a class="mobile-menu__social-link" href="#">Instagram</a></li>
        <li><a class="mobile-menu__social-link" href="#">TikTok</a></li>
        <li><a class="mobile-menu__social-link" href="#">YouTube</a></li>
      </ul>
    </div>
  </div>
</header>

<style>

.skip-link {
  position: absolute; top: -4rem; left: 1rem; z-index: 1100; padding: .75rem 1rem; border-radius: var(--radius-pill);
  background: var(--color-ink); color: var(--color-white); font: 600 .8rem var(--font-body); text-decoration: none;
}
.skip-link:focus-visible { top: 1rem; }
 
.site-header { position: fixed; inset: 0 0 auto 0; z-index: 1000; color: var(--color-ink); transition: color .3s; }
.site-header::before {            /* background layer: a pseudo-element, so backdrop-filter never traps the fixed mobile menu */
  content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity .3s;
  background: rgb(243 240 233 / .88); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border-bottom: 1px solid rgb(18 18 18 / .08);
}
.site-header.is-scrolled::before { opacity: 1; }
.site-header.is-menu-open { color: var(--color-white); }
.site-header.is-menu-open::before { opacity: 0; }
.site-header.is-menu-open :focus-visible { outline-color: var(--color-white); }
 
.site-nav { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; min-height: var(--header-h); }
.site-nav__logo {
  display: inline-flex; align-items: center; gap: .5rem; justify-self: start;
  color: inherit; text-decoration: none; font: 400 1.35rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .02em;
}
.site-nav__logo-mark { width: 1.5rem; height: 1.5rem; }
.site-nav__list { display: none; margin: 0; padding: 0; list-style: none; }
.site-nav__link {
  position: relative; display: inline-block; padding-block: .75rem;
  color: inherit; text-decoration: none; font: 500 .8rem/1 var(--font-body); letter-spacing: .04em; text-transform: uppercase;
}
.site-nav__link::after {          /* underline wipe */
  content: ""; position: absolute; inset: auto 0 .45rem; height: 2px; background: var(--color-accent);
  transform: scaleX(0); transform-origin: right; transition: transform .35s var(--ease-menu);
}
.site-nav__link:hover::after, .site-nav__link:focus-visible::after, .site-nav__link[aria-current="page"]::after {
  transform: scaleX(1); transform-origin: left;
}
.site-nav__actions { display: flex; align-items: center; gap: 1rem; justify-self: end; }
.site-nav__cart {
  display: inline-flex; gap: .3rem; padding-block: .75rem;
  color: inherit; text-decoration: none; font: 500 .8rem/1 var(--font-body); letter-spacing: .04em; text-transform: uppercase;
}
.site-nav__login {
  display: none; align-items: center; min-height: 2.75rem; padding-inline: 1.25rem;
  border: 1.5px solid currentColor; border-radius: var(--radius-pill);
  color: inherit; text-decoration: none; font: 600 .75rem/1 var(--font-body); letter-spacing: .06em; text-transform: uppercase;
  transition: background-color .25s, color .25s;
}
.site-nav__login:hover { background: var(--color-ink); color: var(--color-white); }
 
/* Toggle: two bars morph into an X */
.menu-toggle {
  position: relative; width: 2.75rem; height: 2.75rem; padding: 0;
  border: 1.5px solid currentColor; border-radius: 50%; background: transparent; color: inherit; cursor: pointer;
}
.menu-toggle__bar {
  position: absolute; top: 50%; left: 50%; width: 1.1rem; height: 2px; margin: -1px 0 0 -.55rem;
  border-radius: 2px; background: currentColor; transition: transform .45s var(--ease-menu);
}
.menu-toggle__bar--top { transform: translateY(-4px); }
.menu-toggle__bar--bottom { transform: translateY(4px); }
.menu-toggle[aria-expanded="true"] .menu-toggle__bar--top { transform: rotate(45deg); }
.menu-toggle[aria-expanded="true"] .menu-toggle__bar--bottom { transform: rotate(-45deg); }
 
/* Mobile menu: panel wipes down, links slide up out of masks */
.mobile-menu {
  position: fixed; inset: 0; z-index: -1;
  display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
  padding: calc(var(--header-h) + 2rem) 1rem 2rem;
  overflow-y: auto; overscroll-behavior: contain;
  background: var(--color-ink); color: var(--color-white);
  clip-path: inset(0 0 100% 0); visibility: hidden;
  transition: clip-path .6s var(--ease-menu), visibility 0s linear .6s;
}
.mobile-menu.is-open { clip-path: inset(0); visibility: visible; transition-delay: 0s; }
.mobile-menu__list { display: grid; gap: .25rem; margin: 0; padding: 0; list-style: none; }
.mobile-menu__item { overflow: hidden; }
.mobile-menu__link {
  display: block; padding-block: .1em; color: inherit; text-decoration: none; text-transform: uppercase;
  font: 400 clamp(2.75rem, 13vw, 5rem)/1 var(--font-display);
  transform: translateY(110%); transition: transform .3s var(--ease-menu), color .25s;
}
.mobile-menu.is-open .mobile-menu__link {
  transform: none; transition: transform .8s var(--ease-menu) calc(.25s + var(--i, 0) * .07s), color .25s;
}
.mobile-menu__link:hover, .mobile-menu__link:focus-visible { color: var(--color-accent); }
.mobile-menu__link:focus-visible { outline-offset: -3px; }   /* item has overflow:hidden, so keep the ring inside */
.mobile-menu__footer {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
  opacity: 0; transition: opacity .2s;
}
.mobile-menu.is-open .mobile-menu__footer { opacity: 1; transition: opacity .5s ease .55s; }
.mobile-menu__socials { display: flex; gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
.mobile-menu__social-link {
  display: inline-block; padding-block: .75rem; color: inherit; text-decoration: none;
  font: 500 .75rem/1 var(--font-body); letter-spacing: .06em; text-transform: uppercase;
}
.mobile-menu__social-link:hover { color: var(--color-accent); }
.is-scroll-locked { overflow: hidden; }
 
@media (min-width: 60rem) {
  .site-nav { grid-template-columns: 1fr auto 1fr; }     /* links truly centered */
  .site-nav__list { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 2.5rem); }
  .site-nav__login { display: inline-flex; }
  .menu-toggle, .mobile-menu { display: none; }
}
 
</style>

<script>


(()=>{
const header = document.querySelector(".site-header");
  const toggle = header.querySelector(".menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const pageRegions = document.querySelectorAll("main, footer");   // made inert while the menu is open
  const desktop = window.matchMedia("(min-width: 60rem)");

  const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

 function setMenu  (open){
    toggle.setAttribute("aria-expanded", String(open))
    menu.classList.toggle("is-open", open)
    menu.inert = !open;
    header.classList.toggle("is-menu-open", open)
    pageRegions.forEach((el) => { el.inert = open; });
    document.documentElement.classList.toggle("is-scroll-locked", open);
  }

  toggle.addEventListener("click", ()=> setMenu(!isOpen()))
  menu.addEventListener("click", (e)=> {if (e.target.closest("a")) setMenu(false);})
  document.addEventListener("keydown", (e)=>{
    if (e.key === "Escape" && isOpen()) {setMenu(false); toggle.focus()};
  })

  
  // Header background appears after the first few pixels of scroll
  const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
})();

</script>